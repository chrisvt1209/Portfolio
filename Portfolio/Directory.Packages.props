<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="GoogleAuthenticator" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Web.Xdt" Version="3.2.14" />
    <PackageVersion Include="NetEscapades.AspNetCore.SecurityHeaders" Version="1.3.1" />
    <PackageVersion Include="NetEscapades.AspNetCore.SecurityHeaders.TagHelpers" Version="1.3.1" />
    <PackageVersion Include="NWebsec.AspNetCore.Middleware" Version="3.0.0" />
    <PackageVersion Include="StackExchange.Exceptional.AspNetCore" Version="3.0.1" />
    <PackageVersion Include="Umbraco.Cms" Version="18.3.0" />
    <PackageVersion Include="Umbraco.Community.Contentment" Version="7.2.2" />
    <PackageVersion Include="uSync" Version="18.3.0" />
  </ItemGroup>
</Project>