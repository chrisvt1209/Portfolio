@using NetEscapades.AspNetCore.SecurityHeaders
@using Portfolio.Models.Umbraco
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    var langCode = VariationContextAccessor.VariationContext?.Culture;
    var languages = await LanguageService.GetAllAsync();
    var home = await Content.GetHomeAsync();
    var settings = await Content.GetSettingsAsync();
    var currentPage = Model as IPage;
}

<!DOCTYPE html>
<html lang="@langCode" data-site-name="@settings?.TxtFullName">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1"
          name="viewport">
    
    <title>@currentPage?.PageTitle | @settings?.TxtFullName</title>
    
    <link rel="icon" href="/icons/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icons/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icons/favicon-192x192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <meta name="theme-color" content="#0b0f0b">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @foreach (var language in languages)
    {
        if (language.IsoCode != langCode)
        {
            <link rel="alternate" hreflang="@language.IsoCode" href="@Model.Url(culture: language.IsoCode, mode: UrlMode.Absolute)">
        }
    }
    <link rel="alternate" hreflang="x-default" href="@(Model.Url(culture: "en-US", mode: UrlMode.Absolute))" />
    <link rel="canonical" href="@(Model.Url(mode: UrlMode.Absolute))" />
    <link nonce="@ViewContext.HttpContext.GetNonce()" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />
    <link nonce="@ViewContext.HttpContext.GetNonce()" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
    <link nonce="@ViewContext.HttpContext.GetNonce()"
          href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap"
          rel="stylesheet" />
    
    <link asp-add-nonce rel="stylesheet" href="bundles/scss/styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Style", false)
</head>
<body>
    <div class="site-preloader" id="site-preloader" aria-hidden="true">
        <div class="site-preloader-backdrop"></div>
        <div class="site-preloader-shell">
            <p class="panel-label">@settings?.TxtPanelLabel</p>
            <div class="site-preloader-terminal">
                <div class="site-preloader-chrome">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="site-preloader-body">
                    <p class="site-preloader-line is-muted">@settings?.TxtPreloaderLineMuted</p>
                    <p class="site-preloader-line is-main"><span class="site-preloader-prompt">&gt;</span>@settings?.TxtPreloaderLineMain</p>
                    <p class="site-preloader-line is-accent">@settings?.TxtPreloaderLineAccent</p>
                    <div class="site-preloader-meter">
                        <span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="particle-field" aria-hidden="true"></div>
    @RenderBody()

    <button class="scroll-top" type="button" aria-label="Scroll back to top">
        <span></span>
    </button>
    <script asp-add-nonce>
            const CURRENT_LANG = '@Html.Raw(langCode)';
            const DATE_FORMAT = "dd-MM-yyyy";
            const HOME_URL = '@Html.Raw(home?.Url())';
        </script>
    <script asp-add-nonce type="module" src="bundles/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", false)
    <Esbuild-Script nonce="@ViewContext.HttpContext.GetNonce()"/>
</body>
</html>