@using Portfolio.Infrastructure.Extensions
@using Portfolio.Models.Umbraco
@inherits UmbracoViewPage<ProjectsViewModel>
@{
    var index = -1;
}
<section class="content-section" id="projects">
    <div class="section-label">
        <span>@ViewData["SectionNumber"]</span>
        <p>@Model.Name</p>
    </div>

    <div class="section-body showcase-stack">
        <div class="text-block">
            <h2>@Model.TxtHeader</h2>
            @if (!string.IsNullOrEmpty(Model.Body?.ToString()))
            {
                @Html.Raw(Model.Body)
            }
        </div>
        @foreach (var item in Model.ProjectsBlockList!)
        {
            if (item.Content is not ProjectItem projectItem)
            {
                continue;
            }

            index++;
            var imageUrl = projectItem.Projectimages?.FirstOrDefault()?.Url();

            <article class="showcase-card@(index % 2 == 1 ? " showcase-card-reverse" : "")">
                <div class="showcase-copy">
                    <p class="panel-label">@projectItem.TxtEyebrow</p>
                    <h3>@projectItem.TxtTitle</h3>
                    @projectItem.TxtDescription
                    <ul class="tag-list">
                        @foreach (var tag in projectItem.ProjectTags.SplitLines())
                        {
                            <li class="underline">@tag</li>
                        }
                    </ul>
                </div>

                <div class="showcase-visual">
                    <figure class="project-placeholder">
                        @if (string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <div class="project-placeholder-empty" role="img" aria-label="@projectItem.TxtTitle">
                                <span>Geen Preview Beschikbaar</span>
                            </div>
                        }
                        else
                        {
                            <img src="@imageUrl" alt="@projectItem.TxtTitle">
                        }
                    </figure>
                </div>
            </article>
        }
    </div>
</section>
