@using Portfolio.Models.Umbraco
@inherits UmbracoViewPage<HomeViewModel>
@inject IPublishedValueFallback PublishedValueFallback
@{
	var settings = await Content.GetSettingsModelAsync();
}

<partial name="~/Views/Partials/_Header.cshtml" model="Model"/>

<div class="page-shell">
	<main>
		<partial name="~/Views/Partials/_Hero.cshtml" model="Model" />
		@foreach (var child in Model.Children())
		{
			(string PartialName, object Model)? section = child.ContentType.Alias switch
			{
				About.ModelTypeAlias => ("_About", new AboutViewModel(child, PublishedValueFallback)),
				Experience.ModelTypeAlias => ("_Experience", new ExperienceViewModel(child, PublishedValueFallback)),
				Projects.ModelTypeAlias => ("_Projects", new ProjectsViewModel(child, PublishedValueFallback)),
				MoreProjects.ModelTypeAlias => ("_MoreProjects", new MoreProjectsViewModel(child, PublishedValueFallback)),
				_ => null
			};

			if (section is null)
			{
				continue;
			}

			<div class="section-slot is-loaded" data-section="@child.ContentType.Alias" data-title="@((child as IPage)?.PageTitle)">
				<partial name="@($"~/Views/Partials/{section.Value.PartialName}.cshtml")" model="section.Value.Model" />
			</div>
		}
	</main>
</div>

<partial name="~/Views/Partials/_Footer.cshtml" model="@settings"/>
