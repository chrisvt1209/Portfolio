{
  "$schema": "./appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "OpenIddict.Server": "Warning",
        "OpenIddict.Core": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "RestrictedToMinimumLevel": "Verbose",
          "Path": "umbraco/CustomLogs/Verbose/verbose.json",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 3,
          "Formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "RestrictedToMinimumLevel": "Debug",
          "Path": "umbraco/CustomLogs/Debug/debug.json",
          "RollingInterval": "Day",
          "RetainedFileCountLimit": 3,
          "Formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "UmbracoFile",
        "Args": {
          "RestrictedToMinimumLevel": "Information",
          "FileSizeLimitBytes": 1073741824,
          "RollingInterval": "Day",
          "FlushToDiskInterval": null,
          "RollOnFileSizeLimit": false,
          "RetainedFileCountLimit": 31
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Umbraco": {
    "CMS": {
      "Imaging": {
        "HMACSecretKey": "uO/9iHS3MdRfLHuPZuKaGuIHYcMp66rlpGn2v\u002BiUbTliIwnJdy2w1D6n3V/vB\u002BntWPAGF3459cpprsDp10Gltw=="
      }
    }
  }
}