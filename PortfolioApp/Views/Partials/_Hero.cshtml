@using PortfolioApp.Models.Umbraco
@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    var indexPage = Model.AncestorOrSelf<Home>();

    if (indexPage is null) return;
}

<section class="hero" id="top">
    <div class="hero-copy">
        <p class="eyebrow">@indexPage.HeroIntroductionText</p>
        <h1 class="hero-name" data-text="@indexPage.HeroNameText" aria-label="@indexPage.HeroNameText">
            @indexPage.HeroNameText
        </h1>
        <h2 class="hero-role">@indexPage.HeroExpertiseText</h2>
        <p class="hero-text">
            @Html.Raw(indexPage.HeroDescriptionText)
        </p>

        <div class="hero-actions d-flex flex-wrap gap-3">
            <a class="button button-primary" href="#about">@indexPage.HeroButtonAboutMeText</a>
            <a class="button button-secondary" href="#projects">@indexPage.HeroButtonProjectsText</a>
        </div>

        <ul class="hero-meta" aria-label="Kernpunten">
            @foreach (var skill in indexPage.HeroHighlightedSkills!)
            {
                <li>@skill</li>
            }
        </ul>
    </div>
</section>