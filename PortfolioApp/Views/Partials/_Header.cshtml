@using PortfolioApp.Models.Umbraco
@using Umbraco.Cms.Web.Common.PublishedModels
@using PortfolioApp.Infrastructure.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    var root = Umbraco.ContentAtRoot().FirstOrDefault();
    var sections = Model.Children()?.FirstOrDefault(x => x.ContentType.Alias == Sections.ModelTypeAlias);
    var navItems = sections?.Children() ?? Enumerable.Empty<IPublishedContent>();
}

<div class="container-fluid header-shell px-0">
    <header class="site-header d-flex align-items-center px-4 py-3">
        <a class="brand" href="#top">
            <span class="brand-mark">CVT</span>
        </a>

        <nav class="site-nav d-flex align-items-center justify-content-center gap-4 position-absolute start-50 translate-middle-x"
             id="site-nav" aria-label="Hoofdnavigatie">
            @foreach (var item in navItems)
            {
                <a class="underline" href="@item.GetAnchor()">@item.Name.ToUpper()</a>
            }

            <a class="header-cta header-cta-mobile d-lg-none" href="resume.pdf" download>Download CV</a>
        </nav>

        <div class="header-actions d-flex align-items-center gap-3 ms-auto">
            <a class="header-cta d-none d-lg-inline-flex" href="resume.pdf" download>Download CV</a>
            <button class="menu-toggle d-inline-flex d-lg-none align-items-center justify-content-center"
                    type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>
</div>
