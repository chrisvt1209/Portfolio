@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IPublishedContent>
@{
    var langCode = VariationContextAccessor.VariationContext?.Culture;
    var languages = await LanguageService.GetAllAsync();
}

<!DOCTYPE html>
<html lang="@langCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio - Chris van Tiggelen</title>
    @foreach (var language in languages)
    {
        if (language.IsoCode != langCode)
        {
            <link rel="alternate" hreflang="@language.IsoCode" href="@Model.Url(culture: @language.IsoCode, mode: UrlMode.Absolute)">
        }
    }
    <link rel="alternate" hreflang="x-default" href="@(Model.Url(culture: "en-US", mode: UrlMode.Absolute))" />
    <link rel="canonical" href="@(Model.Url(mode: UrlMode.Absolute))" />

    <link asp-append-version="true" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <link asp-append-version="true" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" asp-append-version="true">

    <link asp-add-nonce rel="stylesheet" href="/bundles/scss/styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Style", false)
</head>
<body>
    <div class="particle-field" aria-hidden="true"></div>
    @await Html.PartialAsync("~/Views/Partials/_Header.cshtml", Model)
    <div class="page-shell">
        <main>
            @RenderBody()
        </main>
    </div>
    <script asp-add-nonce src="/bundles/js/script.js" asp-append-version="true" type="module"></script>
    @await RenderSectionAsync("Scripts", false)
    <Esbuild-Script/>
</body>
</html>
